# 後端專屬環境變數範本 —— 複製成 backend/.env 後調整(.env 已進 .gitignore,絕不 commit)
#
# 注意:跨層共用的 GEMINI_API_KEY 放「專案根目錄 .env」(arxiv-1-完成版/.env),
# 後端會優先讀根目錄 .env,本檔(backend/.env)作 fallback。這裡只放後端專屬調參。

# Gemini 模型(app-spec 指定);非機密,可在此覆寫
GEMINI_MODEL=gemini-3.5-flash

# FastAPI 服務埠(前端 AppConfig.backendBaseUrl 預設 127.0.0.1:8000)
PORT=8000

# --- 以下為可選調參,通常不用動(留空即用程式預設) ---
# arXiv 收的分類(逗號分隔);預設 cs.AI,cs.LG,cs.CL,可加 cs.CV,cs.RO
# ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
# 多抓幾篇再去重(預設 15)/ 去重後保留前幾篇(預設 5)
# ARXIV_FETCH_SIZE=15
# ARXIV_TOP_N=5
# 連續請求最小間隔秒數(arXiv ToU 要求 ≥3)
# ARXIV_REQUEST_INTERVAL_SEC=3
# 報告 JSON 存放目錄(預設 backend/data)
# DATA_DIR=
