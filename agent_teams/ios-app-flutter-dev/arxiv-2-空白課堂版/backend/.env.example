# 後端環境變數範本 —— 複製成 backend/.env 後填值（.env 已進 .gitignore，絕不 commit）

# Gemini API key（機密！只放 .env，不要 commit）。沒填時後端走 mock/sample 報告 fallback。
GEMINI_API_KEY=

# Gemini 模型（app-spec 指定）；非機密，可覆寫
GEMINI_MODEL=gemini-3.5-flash

# FastAPI 服務埠（前端 AppConfig.backendBaseUrl 預設 127.0.0.1:8000）
PORT=8000

# --- 可選調參（留空即用程式預設）---
# arXiv 收的分類（逗號分隔）；凍結預設 cs.AI,cs.LG,cs.CL,cs.CV
# ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV
# 最新 N 篇（凍結預設 5）
# ARXIV_TOP_N=5
# 連續請求最小間隔秒數（arXiv 使用規範要求 ≥3）
# ARXIV_REQUEST_INTERVAL_SEC=3
# 報告 JSON 存放目錄（預設 backend/data）
# DATA_DIR=
