# ──────────────────────────────────────────────
# Claude Code 公開課教學包 — 環境變數範本
# 複製成 .env 後填值：cp .env.example .env
# 實際 .env 已被 .gitignore 排除
# ──────────────────────────────────────────────

# === Anthropic / Claude ===
ANTHROPIC_API_KEY=

# === OpenAI（Projects/ 內某些範例會用到） ===
OPENAI_API_KEY=

# === Google / Gemini（選用） ===
GOOGLE_API_KEY=

# === Discord Bot（Projects/06-discord-dm-bot） ===
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

# === YouTube Data API（Projects/03-youtube-notes 進階用） ===
YOUTUBE_API_KEY=

# === Firecrawl（plugin / skill 範例會用到） ===
FIRECRAWL_API_KEY=

# === LangSmith / Langfuse 觀測（選用） ===
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === 一般環境 ===
NODE_ENV=development
LOG_LEVEL=info
