{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workshop-bc/requirements/1.0",
  "title": "C 需求 requirements.json（schema_version 1.0）",
  "type": "object",
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "statement", "status", "interfaces", "evidence_ids", "acceptance_ids", "behavior", "exceptions"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "statement": {"type": "string"},
          "status": {"type": "string", "enum": ["approved", "proposed", "unresolved", "rejected", "deferred"]},
          "interfaces": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "acceptance_ids": {"type": "array", "items": {"type": "string"}},
          "behavior": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}},
          "target": {
            "type": "object",
            "required": ["name", "value", "unit", "status"],
            "properties": {"value": {"type": ["number", "null"]}, "unit": {"type": "string"}, "status": {"type": "string"}}
          },
          "reference_values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "value", "unit", "run_id", "scenario", "metric", "basis"],
              "properties": {"value": {"type": ["number", "null"]}, "unit": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
